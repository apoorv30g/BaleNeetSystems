NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:password@localhost:5432/loanconnect
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_64_char_random_secret

FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
CORS_ORIGIN_SUFFIXES=
SERVER_URL=http://localhost:4000

EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_FROM_NUMBER=
EXOTEL_API_BASE=https://api.in.exotel.com
EXOTEL_OUTBOUND_COST_PER_MINUTE_INR=0.60
EXOTEL_INBOUND_COST_PER_MINUTE_INR=0.20
EXOTEL_ATTEMPT_COST_INR=0.06
EXOTEL_CHANNEL_MONTHLY_COST_INR=1500
EXOTEL_CHANNEL_COUNT=1
EXOTEL_MIN_MONTHLY_BILLING_INR=20000

# Sarvam is the ONLY permitted AI provider (STT, TTS and LLM). Gemini and Deepgram were
# removed for India data-residency compliance: borrower call audio and transcripts must not
# leave Indian jurisdiction. Do not add a non-Indian AI provider without a compliance review.
SARVAM_API_KEY=

# Sarvam chat model (used for LLM fallback replies + self-training proposal drafting).
# sarvam-30b recommended for live calls (lower latency); sarvam-105b for higher quality.
# Do NOT set this to sarvam-m / sarvam-m:v1 / sarvam-24b / sarvam-2b — that model is
# deprecated (Sarvam end-of-life 2026-07-27). config.js auto-upgrades and warns if it is set.
SARVAM_CHAT_MODEL=sarvam-30b

# STT model used for live call transcription and preflight health checks.
SARVAM_STT_MODEL=saaras:v3

# TTS voice settings (bulbul:v3 recommended)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=hi-IN
# pace: 0.5 (slow) to 1.5 (fast) — 0.9 feels natural on calls
SARVAM_TTS_PACE=0.9
# loudness: amplification multiplier — 1.5 recommended for phone calls
SARVAM_TTS_LOUDNESS=1.5

CALL_WINDOW_START=9
CALL_WINDOW_END=20
MAX_CALL_ATTEMPTS=3
MAX_CONCURRENT_CALLS=20
CALL_DISPATCH_SPACING_SECONDS=0
CALL_CHANNEL_HOLD_MAX_SECONDS=0
CALL_CHANNEL_POLL_MS=1000
CALL_RETRY_DELAY_MINUTES=360

LOAN_APP_URL=https://www.asapfinance.in
PAYMENT_LINK_BASE=https://yourapp.com/pay
SUPPORT_PHONE=
VOICEBOT_TOKEN=

# Brand identity spoken by the AI on calls (identity line, disclosure default, pronunciation
# hint, and the Exotel fallback greeting). Does not affect the TEZ_* playbooks, which are
# hardcoded to the TezCredit journey regardless of this value.
BRAND_NAME=ASAP Finance
ASSISTANT_NAME=Sneha

# Webhook security — set to a random secret and pass as ?secret= on Exotel callback URLs.
# REQUIRED in production: webhooks return 403 if NODE_ENV=production and this is unset.
EXOTEL_WEBHOOK_SECRET=

# LLM circuit breaker — open after N consecutive failures, reset after M ms
LLM_CIRCUIT_THRESHOLD=5
LLM_CIRCUIT_RESET_MS=30000

# Upload limits
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_ROWS=10000

# Lead enqueue batch limit (rows fetched per queue-calls request)
ENQUEUE_BATCH_LIMIT=5000

# Audio PCM cache size (number of entries before LRU eviction)
VOICEBOT_PCM_CACHE_MAX=200

# Database connection pool
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=3000
DB_MAX_USES=7500

# JWT expiry (e.g. 8h, 1d) — keep short; no refresh token flow currently
JWT_EXPIRY=8h

# Provider fetch timeouts
SARVAM_TTS_TIMEOUT_MS=12000

# --- Monitoring & alerting ---
# REQUIRED in production: without it /metrics fails closed (503) rather than publishing
# operational internals to the internet.
METRICS_TOKEN=
# Slack/Teams/Google Chat incoming webhook. Accepts {"text": "..."}. Without it, alerts are
# still written to the log but nobody is notified.
# Deliberately self-hosted: hosted error trackers would ship data to US infrastructure, which
# would reintroduce the cross-border flow the Sarvam-only decision exists to prevent.
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_MS=900000
# Alert thresholds
ALERT_CALL_FAILURE_RATE=0.5
ALERT_CALL_FAILURE_MIN_SAMPLE=10
ALERT_QUEUE_DEPTH=500
SARVAM_PREFLIGHT_ALERT_THRESHOLD=3
WORKER_FAILURE_ALERT_THRESHOLD=5

# --- Data retention (borrower conversation records) ---
TRANSCRIPT_RETENTION_DAYS=180
EVENT_RETENTION_DAYS=90
AUDIO_CACHE_RETENTION_HOURS=24

# --- Collections guardrails (RBI fair practice) ---
# Contact caps apply per BORROWER across ALL campaigns, unlike MAX_CALL_ATTEMPTS which is
# per lead row per campaign. Overridden per tenant in the compliance UI. 0 = no cap.
MAX_CONTACTS_PER_DAY=1
MAX_CONTACTS_PER_WEEK=3

# --- Auth ---
# How long a revoked session may survive in memory before the DB is re-checked. 0 = check
# every request.
AUTH_REVOCATION_CACHE_MS=30000

# Set to false for local debugging only. Never in production -- logs carry transcripts.
LOG_REDACT_PII=true

# Worker health server port
WORKER_HEALTH_PORT=4001
